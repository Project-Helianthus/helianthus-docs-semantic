[
  {
    "id": "I-TWO-LIFECYCLES",
    "expected": {
      "outcome": "equal sorted node ids, link keys, endpoints, types, aliases and source links",
      "varied": [
        "factory order",
        "discovery order",
        "clocks",
        "generations"
      ],
      "compared": "canonical graph results after reopening durable state",
      "excluded": [
        "cut digests",
        "timestamps",
        "leases"
      ]
    },
    "explanation": "Two fresh lifecycles with identical installation keys, configuration and topology."
  },
  {
    "id": "I-THREE-INSTANCES",
    "expected": {
      "outcome": "three same-kind instances keep three disjoint node sets under their instance keys",
      "instances": 3,
      "shared_nodes": 0
    },
    "explanation": "Several instances of one driver kind do not share identity."
  },
  {
    "id": "I-SHARED-EBUS",
    "expected": {
      "outcome": "two direct links and a shared bus keep one shared bus node",
      "shared_bus_nodes": 1,
      "direct_links": 2
    },
    "explanation": "A shared eBUS plus two direct links."
  },
  {
    "id": "I-CHANGED-SERIAL",
    "expected": {
      "outcome": "a changed serial is a new unbound claim",
      "new_claim": "unbound",
      "old_reference": "kept",
      "history": "kept",
      "replacement_inferred": false,
      "rebind": "only a person"
    },
    "explanation": "Nothing is inferred as a replacement."
  },
  {
    "id": "I-ABSENT-TARGET",
    "expected": {
      "outcome": "the same To is kept while the target is absent and on its return",
      "to": "unchanged",
      "complete_cut": "dangling",
      "partial_cut": "outside-cut",
      "on_return": "same key resolves with every retained claim and basis",
      "phantom_resource": false
    },
    "explanation": "A declaration to an absent target is kept."
  },
  {
    "id": "I-TWO-PUBLISHERS",
    "expected": {
      "outcome": "two publishers keep separate bases",
      "claims": 2,
      "after_first_withdrawn": {
        "remaining_claims": 1,
        "basis": "second publisher's"
      },
      "after_target_return": {
        "remaining_claims": 1,
        "basis": "second publisher's"
      }
    },
    "explanation": "Each publisher's claim and basis stay separate under one directed tuple."
  },
  {
    "id": "I-ALLOC-LEGACY-SLOT",
    "encoding": "legacy",
    "expected": {
      "outcome": "legacy slot id preserved",
      "domain": "helianthus.semgraph.resource/v1",
      "fields": [
        "resource.zone",
        "slot",
        "resource:00000000000000000000000000000001",
        "zone-1"
      ],
      "id": "resource:a0b7d12925ca145e10e3670e018086ce"
    },
    "explanation": "The donor allocator domain and encoding are kept exactly: each field preceded by one 0x00 byte."
  },
  {
    "id": "I-ALLOC-LEGACY-KEY",
    "encoding": "legacy",
    "expected": {
      "outcome": "legacy native key id preserved",
      "domain": "helianthus.semgraph.resource/v1",
      "kind": "resource.equipment",
      "identity": {
        "scheme": "scheme.ieee.eui48",
        "issuer": "",
        "token": "0A1B2C3D4E5F"
      },
      "id": "resource:eb2e2bec29873eff6599e98733aaa17e"
    },
    "explanation": "The identity key is sha256 of the canonical JSON of scheme, issuer and token; the id hashes kind, key, digest."
  },
  {
    "id": "I-ALLOC-PATH-SLOT",
    "encoding": "path",
    "expected": {
      "outcome": "path-node slot id",
      "domain": "helianthus.semgraph.path-node/v1",
      "key": {
        "installation": "inst-a",
        "driver_kind": "driver-x",
        "instance_key": "i1",
        "node_kind": "resource.bridge",
        "anchor": {
          "tag": "slot",
          "parent": "",
          "slot": "primary"
        }
      },
      "id": "resource:70dc2ac7d92d82c2e1f254a5c532541d"
    },
    "explanation": "Length-prefixed fields under the path-node domain; an anchor without a parent has an empty parent field."
  },
  {
    "id": "I-ALLOC-PATH-KEY",
    "encoding": "path",
    "expected": {
      "outcome": "path-node key id",
      "domain": "helianthus.semgraph.path-node/v1",
      "key": {
        "installation": "inst-a",
        "driver_kind": "driver-x",
        "instance_key": "i1",
        "node_kind": "resource.bridge",
        "anchor": {
          "tag": "key",
          "identity": {
            "scheme": "scheme.ieee.eui48",
            "issuer": "",
            "token": "0A1B2C3D4E5F"
          }
        }
      },
      "id": "resource:ee5fba45d9c4a6dfd8dad3236f362e93"
    },
    "explanation": "A durable key anchor carries the identity digest."
  },
